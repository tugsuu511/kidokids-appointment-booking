generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  DOCTOR
  NURSE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  COMPLETED
  PAID
  CANCELLED
  NO_SHOW
}

enum PaymentOrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  staffTypeId  String?
  staffType    StaffType? @relation(fields: [staffTypeId], references: [id], onDelete: Restrict)
  phone        String?
  sessionVersion Int    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
  doctor    Doctor?

  @@index([staffTypeId])
}

model StaffType {
  id        String   @id @default(cuid())
  name      String   @unique
  role      UserRole
  createdAt DateTime @default(now())
  users     User[]
}

model Department {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]
}

model Doctor {
  id           String          @id @default(cuid())
  fullName     String
  phone        String
  room         String?
  userId       String?         @unique
  user         User?           @relation(fields: [userId], references: [id])
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  schedules    DoctorSchedule[]
  appointments Appointment[]
  visitRecords VisitRecord[]
}

model Patient {
  id          String       @id @default(cuid())
  registerNo  String?      @unique
  firstName   String
  lastName    String
  phone       String
  birthDate   DateTime?
  gender      Gender?
  address     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  appointments Appointment[]

  @@index([phone])
  @@index([firstName, lastName])
}

model Service {
  id           String       @id @default(cuid())
  name         String
  durationMin  Int
  price        Decimal      @db.Decimal(10, 2)
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id])
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  appointments Appointment[]

  @@index([departmentId])
}

model DoctorSchedule {
  id          String   @id @default(cuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
  dayOfWeek   Int
  startTime   String
  endTime     String
  slotMinutes Int
  isActive    Boolean  @default(true)

  @@index([doctorId, dayOfWeek])
}

model Appointment {
  id              String            @id @default(cuid())
  appointmentDate DateTime
  startTime       String
  endTime         String
  patientId       String
  doctorId        String
  serviceId       String
  status          AppointmentStatus @default(BOOKED)
  notes           String?
  followUpOfId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  visitRecord VisitRecord?
  paymentOrder PaymentOrder?
  followUpOf Appointment? @relation("FollowUpAppointments", fields: [followUpOfId], references: [id])
  followUps Appointment[] @relation("FollowUpAppointments")

  @@index([appointmentDate])
  @@index([doctorId, appointmentDate])
  @@index([patientId])
  @@index([followUpOfId])
}

model VisitRecord {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  doctorId      String
  note          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@index([doctorId, updatedAt])
}

model PaymentOrder {
  id            String             @id @default(cuid())
  appointmentId String             @unique
  amount        Decimal            @db.Decimal(10, 2)
  description   String?
  status        PaymentOrderStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
